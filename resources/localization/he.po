msgstr ""
"Language: he\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Recover tree from before last restore"
msgstr "החזרת העץ מלפני השחזור האחרון"

msgid "No previous restore is available."
msgstr "אין כרגע עותק מלפני שחזור קודם."

msgid "Journal"
msgstr "יומן העץ"

msgid "Settings"
msgstr "הגדרות"

msgid "Close"
msgstr "סגירה"

msgid "Shape"
msgstr "עיצוב"

msgid "Undo change"
msgstr "ביטול הפעולה"

msgid "Remove whole branch"
msgstr "הסרת הענף כולו"

msgid "Shorten branch"
msgstr "קיצור הענף"

msgid "Turn left / right"
msgstr "סיבוב ימינה ושמאלה"

msgid "Tilt down / up"
msgstr "הטיה למעלה ולמטה"

msgid "Your tree's name"
msgstr "שם העץ שלך"

msgid "Save name"
msgstr "שמירת השם"

msgid "Care guide"
msgstr "מדריך טיפול"

msgid "Keep a copy of your tree outside the app. Restore it on another device or after reinstalling."
msgstr "כדאי לשמור עותק של העץ מחוץ לאפליקציה. כך אפשר לשחזר אותו במכשיר אחר או אחרי התקנה מחדש."

msgid "Export backup"
msgstr "ייצוא גיבוי"

msgid "Restore backup"
msgstr "שחזור מגיבוי"

msgid "A tree of your own"
msgstr "עץ משלך"

msgid "Start by looking. Drag to turn the tree and pinch to get closer. Tap a branch to inspect it."
msgstr "מתחילים בהתבוננות. גוררים כדי לסובב את העץ וצובטים כדי להתקרב. נוגעים בענף כדי לבדוק אותו."

msgid "Water when the soil is dry. Fertilizer is occasional; adding more does not mean faster growth."
msgstr "משקים כשהאדמה יבשה. מדשנים רק מדי פעם; יותר דשן לא מבטיח יותר צמיחה."

msgid "Prune to make space. Amber branches show what will be removed."
msgstr "גוזמים כדי לפנות מקום. החלקים שיוסרו מסומנים בכתום."

msgid "Your tree grows between visits. Changes accumulate over hours. Long absences are protected, and the tree can recover."
msgstr "העץ גדל גם בין ביקורים. השינוי מצטבר לאורך שעות. בהיעדרות ארוכה העץ נכנס למנוחה ויכול להתאושש כשתחזרו."

msgid "The journal keeps the first portrait and your recent ones. Compare them to see your work over time."
msgstr "היומן שומר את הדיוקן הראשון ואת הדיוקנאות האחרונים. אפשר להשוות ביניהם ולראות איך העץ השתנה."

msgid "Start caring"
msgstr "אל העץ שלי"

msgid "Save a portrait"
msgstr "שמירת דיוקן"

msgid "Choose a portrait to compare with your tree today."
msgstr "בחרו דיוקן להשוואה עם העץ של היום."

msgid "Restore this backup? It replaces your current tree and settings. The previous save is kept as the local recovery copy."
msgstr "לשחזר את הגיבוי? העץ וההגדרות הנוכחיים יוחלפו. השמירה הקודמת תישמר כעותק שחזור מקומי."

msgid "Restore this tree"
msgstr "שחזור העץ"

msgid "Cancel"
msgstr "ביטול"

msgid "Day %d · %d branches"
msgstr "יום %d · %d ענפים"

msgid "Recent care"
msgstr "טיפולים אחרונים"

msgid "Day %d · %s"
msgstr "יום %d · %s"

msgid "Select a branch to shape"
msgstr "בחרו ענף לעיצוב"

msgid "Keep %d%% of the branch"
msgstr "להשאיר %d%% מהענף"

msgid "The soil is saturated. Let it drain before watering again."
msgstr "האדמה רוויה. כדאי לתת למים להתנקז לפני ההשקיה הבאה."

msgid "The soil is dry. One slow watering will help."
msgstr "האדמה יבשה. השקיה איטית אחת תעזור."

msgid "There is excess fertilizer. Stop feeding and give the roots time."
msgstr "יש עודף דשן. מפסיקים לדשן ונותנים לשורשים זמן להתאושש."

msgid "Low light is slowing growth. Recovery takes time."
msgstr "מעט האור מאט את הצמיחה. ההתאוששות דורשת זמן."

msgid "New cuts are healing. Let the tree recover before shaping again."
msgstr "העץ מתאושש מהגיזום. כדאי לתת לו לנוח לפני שמעצבים שוב."

msgid "The roots are recovering. Keep the soil lightly moist and wait."
msgstr "השורשים מתאוששים. שומרים על אדמה לחה מעט ונותנים להם זמן."

msgid "The soil is low on nutrients. A small dose will support new growth."
msgstr "חסרים חומרי הזנה באדמה. מעט דשן יעזור לצמיחה חדשה."

msgid "The tree is doing well. No care is needed right now."
msgstr "העץ במצב טוב. כרגע אין צורך בטיפול."

msgid "Since your last visit: %d new leaves."
msgstr "מאז הביקור הקודם: %d עלים חדשים."

msgid "Amber shows the cut. Tap again to select an overlapping branch."
msgstr "החלק שיוסר מסומן בכתום. נגיעה נוספת בוחרת ענף חופף."

msgid "Turn and tilt a branch, then apply. Preview does not change your tree."
msgstr "מסובבים ומטים את הענף, ואז מאשרים. התצוגה המקדימה לא משנה את העץ."

msgid "Save is protected. Restore a compatible version before making changes."
msgstr "השמירה מוגנת. יש לפתוח אותה בגרסה תואמת לפני שמשנים את העץ."

msgid "Space for new growth. You can undo this change for 15 seconds."
msgstr "התפנה מקום לצמיחה חדשה. אפשר לבטל את הפעולה במשך 15 שניות."

msgid "The new shape is saved. You can undo it for 15 seconds."
msgstr "העיצוב החדש נשמר. אפשר לבטל אותו במשך 15 שניות."

msgid "Shorten branch · remove %d shoots"
msgstr "לקצר את הענף · יוסרו %d ענפים"

msgid "Apply shape"
msgstr "אישור העיצוב"

msgid "Show today's tree"
msgstr "הצגת העץ של היום"

msgid "Day %d · Show today's tree"
msgstr "יום %d · לעץ של היום"

msgid "Today · Show saved portrait"
msgstr "היום · לדיוקן השמור"

msgid "This backup is invalid or needs another version. Your tree was not changed."
msgstr "הגיבוי פגום או דורש גרסה אחרת. העץ שלך לא השתנה."

msgid "Backup exported. Keep it somewhere safe."
msgstr "הגיבוי יוצא בהצלחה. כדאי לשמור אותו במקום בטוח."

msgid "Could not export the backup. Try another location."
msgstr "ייצוא הגיבוי נכשל. נסו לשמור במיקום אחר."

msgid "Your tree has been restored."
msgstr "העץ שוחזר בהצלחה."

msgid "B O N S A I   /   A LIVING PRACTICE"
msgstr "בונסאי / לגדל בקצב שלך"

msgid "Ficus microcarpa"
msgstr "פיקוס מיקרוקרפה"

msgid "Language"
msgstr "שפה"

msgid "Dev"
msgstr "פיתוח"

msgid "A little attention, every day."
msgstr "קצת תשומת לב, בכל יום."

msgid "Observe"
msgstr "בדיקה"

msgid "Water"
msgstr "השקיה"

msgid "Feed"
msgstr "דישון"

msgid "Prune"
msgstr "גיזום"

msgid "View"
msgstr "צפייה"

msgid "Tap a branch to look closer"
msgstr "נגיעה בענף מציגה מידע עליו"

msgid "Undo cut"
msgstr "ביטול הגיזום"

msgid "DRAG TO ORBIT  ·  PINCH TO ZOOM"
msgstr "גרירה לסיבוב · צביטה לקירוב"

msgid "Sound off"
msgstr "צליל כבוי"

msgid "Sound on"
msgstr "צליל פעיל"

msgid "Low"
msgstr "נמוכה"

msgid "Medium"
msgstr "בינונית"

msgid "High"
msgstr "גבוהה"

msgid "Graphics quality"
msgstr "איכות תצוגה"

msgid "Back to care"
msgstr "חזרה לטיפול"

msgid "Water the soil"
msgstr "להשקות את האדמה"

msgid "Add a small dose"
msgstr "להוסיף מעט דשן"

msgid "Select a branch to cut"
msgstr "יש לבחור ענף לגיזום"

msgid "DAY %03d   ·   YOUR WINDOW STUDIO"
msgstr "יום %03d · הסטודיו שלך"

msgid "Moist"
msgstr "לחה"

msgid "Dry"
msgstr "יבשה"

msgid "Waterlogged"
msgstr "רוויה מדי"

msgid "Settling"
msgstr "מתאושש"

msgid "Needs care"
msgstr "זקוק לטיפול"

msgid "Vigorous"
msgstr "חיוני"

msgid "Soil: %s   ·   %s"
msgstr "אדמה: %s · העץ %s"

msgid "Tap a branch. The cut removes it and all its shoots."
msgstr "יש לבחור ענף. הגיזום יסיר אותו ואת כל הענפים שיוצאים ממנו."

msgid "Water slowly. Let the soil breathe between visits."
msgstr "להשקות לאט, ולתת לאדמה להתאוורר בין השקיות."

msgid "A small dose supports growth. Too much stresses roots."
msgstr "מעט דשן מסייע לצמיחה. עודף דשן פוגע בשורשים."

msgid "Hold a branch to inspect. Drag to turn your tree."
msgstr "לחיצה ארוכה על ענף מציגה מידע נוסף. גרירה מסובבת את העץ."

msgid "Keep the main trunk"
msgstr "הגזע הראשי נשאר"

msgid "Cut branch · %d segments"
msgstr "לגזום את הענף · %d מקטעים"

msgid "Healthy"
msgstr "בריא"

msgid "Under stress"
msgstr "במצב עקה"

msgid "Branch %d · %s · Leaves: %d"
msgstr "ענף %d · %s · עלים: %d"

msgid "Branch %d · %s · Leaves: %d · Age: %.1f days"
msgstr "ענף %d · %s · עלים: %d · גיל: %.1f ימים"

msgid "Water settles into the soil."
msgstr "המים נספגים באדמה."

msgid "The soil is saturated. Give it time to drain."
msgstr "האדמה רוויה. כדאי להמתין לניקוז המים."

msgid "A small dose, for the days ahead."
msgstr "מעט דשן להמשך הצמיחה."

msgid "There is already plenty of food in this soil."
msgstr "כבר יש מספיק דשן באדמה."

msgid "Select another branch"
msgstr "בחירת ענף נוסף"

msgid "A little space for new growth. Undo is available for 8 seconds."
msgstr "התפנה מקום לצמיחה חדשה. אפשר לבטל את הגיזום במשך 8 שניות."

msgid "The branch is back."
msgstr "הענף חזר למקומו."

msgid "Reset replaces this tree. Tap Reset tree again to confirm."
msgstr "האיפוס יחליף את העץ הנוכחי. לאישור, יש ללחוץ שוב על איפוס העץ."

msgid "Welcome back. Your tree rested through the long absence."
msgstr "טוב שחזרת. בזמן ההיעדרות הארוכה העץ נכנס למנוחה."

msgid "Welcome back. %.1f days have passed for your tree."
msgstr "טוב שחזרת. עברו %.1f ימים בחיי העץ."

msgid "This tree needs a species pack that is not installed. Save preserved."
msgstr "חבילת המין של העץ הזה אינה מותקנת. השמירה נשמרה ללא שינוי."

msgid "DEVELOPER STUDIO"
msgstr "כלי פיתוח"

msgid "Close"
msgstr "סגירה"

msgid "Pause simulation"
msgstr "השהיית הסימולציה"

msgid "Resume simulation"
msgstr "המשך הסימולציה"

msgid "+1 hour"
msgstr "הוספת שעה"

msgid "+1 day"
msgstr "הוספת יום"

msgid "+1 week"
msgstr "הוספת שבוע"

msgid "+1 month"
msgstr "הוספת חודש"

msgid "Time buttons advance BIOLOGICAL time.\nNormal rate: 1 real hour = 1 biological day."
msgstr "הכפתורים מקדמים את הזמן הביולוגי של העץ.\nבקצב הרגיל: שעה אמיתית = יום בחיי העץ."

msgid "Soil moisture"
msgstr "לחות האדמה"

msgid "Nutrients"
msgstr "דשן"

msgid "Light"
msgstr "אור"

msgid "Damage"
msgstr "פגיעה בעץ"

msgid "Restore"
msgstr "שיקום העץ"

msgid "Spawn growth"
msgstr "יצירת צמיחה"

msgid "Reset tree…"
msgstr "איפוס העץ…"

msgid "Day %.2f | %d branches | %d leaves\nMoisture %.3f | nutrients %.3f\nRoots %.3f | energy %.3f | stress %.3f\nPruning stress %.3f | light %.2f"
msgstr "יום %.2f | ענפים: %d | עלים: %d\nלחות: %.3f | דשן: %.3f\nשורשים: %.3f | אנרגיה: %.3f | עקה: %.3f\nעקת גיזום: %.3f | אור: %.2f"

msgid "ID ← parent | length | radius | buds\n"
msgstr "מזהה ← ענף אב | אורך | רדיוס | ניצנים\n"

msgid "Save is protected. Reset explicitly to start a new tree."
msgstr "השמירה מוגנת. כדי להתחיל עץ חדש יש לאפס אותו במפורש."

msgid "Refused invalid save state."
msgstr "השמירה לא בוצעה כי נתוני העץ אינם תקינים."

msgid "Could not write save file (%d)."
msgstr "לא ניתן לכתוב את קובץ השמירה (קוד %d)."

msgid "Save verification failed."
msgstr "בדיקת תקינות השמירה נכשלה."

msgid "Could not preserve previous save."
msgstr "לא ניתן לגבות את השמירה הקודמת."

msgid "Could not replace save file."
msgstr "לא ניתן להחליף את קובץ השמירה."

msgid "This save belongs to a newer version. It has been preserved."
msgstr "השמירה נוצרה בגרסה חדשה יותר של המשחק. הקובץ נשמר ללא שינוי."

msgid "Recovered the tree from a backup."
msgstr "העץ שוחזר מעותק הגיבוי."

msgid "Save could not be read. Original files were preserved."
msgstr "לא ניתן לקרוא את השמירה. הקבצים המקוריים נשמרו ללא שינוי."

msgid "Purchases are not enabled in this prototype."
msgstr "רכישות אינן זמינות בגרסת הניסוי."

msgid "Dwarf jade"
msgstr "פורטולקריה"

msgid "Chinese elm"
msgstr "אולמוס סיני"

msgid "Slate ceramic"
msgstr "קרמיקה בצבע צפחה"

msgid "Round terracotta"
msgstr "טרקוטה עגולה"

msgid "Ivory ceramic"
msgstr "קרמיקה בצבע שנהב"

msgid "Blue glazed ceramic"
msgstr "קרמיקה כחולה"

msgid "A broad canopy with glossy leaves. A forgiving first tree."
msgstr "צמרת רחבה ועלים מבריקים. עץ נוח להתחלה."

msgid "A compact succulent with fleshy leaves. Enjoys drier soil."
msgstr "צמח קומפקטי עם עלים בשרניים. מסתדר עם אדמה יבשה יותר."

msgid "An airy tree with small leaves and fine branching."
msgstr "עץ עדין עם עלים קטנים וענפים דקים."

msgid "Choose a plant and a planter. Make it yours."
msgstr "בוחרים צמח ואדנית, ויוצרים עץ משלכם."

msgid "1 / 2 · Choose your plant"
msgstr "1 / 2 · בחירת הצמח"

msgid "2 / 2 · Choose your planter"
msgstr "2 / 2 · בחירת האדנית"

msgid "Select a plant to see a preview."
msgstr "בחרו צמח כדי לראות איך הוא נראה."

msgid "Your tree's name (optional)"
msgstr "שם לעץ שלכם (לא חובה)"

msgid "Choose a planter"
msgstr "לבחירת האדנית"

msgid "Start growing"
msgstr "מתחילים לגדל"

msgid "Back"
msgstr "חזרה"

msgid "Create a new tree"
msgstr "צור עץ חדש"

msgid "Close app"
msgstr "סגירת האפליקציה"

msgid "Version %s"
msgstr "גרסה %s"

msgid "Whole branch"
msgstr "ענף שלם"

msgid "Branch segment"
msgstr "מקטע מהענף"

msgid "Compare portrait"
msgstr "השוואה לעץ של היום"
